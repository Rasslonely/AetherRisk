NEXT_PUBLIC_SEPOLIA_CHAIN_KEY="1"
NEXT_PUBLIC_SEPOLIA_EMITTER_ADDRESS="0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9"

# TEE Enclave Configuration (Level 1 Signer Key)
